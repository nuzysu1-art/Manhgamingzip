<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gaming Dashboard Demo</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <div class="app">

        <aside class="sidebar">
            <div class="brand">
                <div class="brand-icon">X</div>
                <div>
                    <strong>GAME<span>LAB</span></strong>
                    <small>CONTROL PANEL</small>
                </div>
            </div>

            <nav>
                <button class="nav-item active" data-page="dashboard">
                    <span>▦</span> Dashboard
                </button>

                <button class="nav-item" data-page="players">
                    <span>◉</span> Players
                </button>

                <button class="nav-item" data-page="settings">
                    <span>⚙</span> Settings
                </button>
            </nav>

            <div class="sidebar-bottom">
                <div class="connection">
                    <i></i>
                    <div>
                        <small>Demo connection</small>
                        <strong>ONLINE</strong>
                    </div>
                </div>
            </div>
        </aside>

        <main class="main">

            <header class="topbar">
                <div>
                    <h1 id="pageTitle">Dashboard</h1>
                    <p>Gaming overlay management & demo environment</p>
                </div>

                <div class="top-actions">
                    <span class="status">
                        <i></i> SYSTEM READY
                    </span>

                    <button id="themeBtn" class="icon-btn">☾</button>
                </div>
            </header>

            <!-- DASHBOARD -->
            <section id="dashboard" class="page active-page">

                <div class="stats-grid">

                    <div class="stat-card">
                        <div class="stat-icon blue">FPS</div>
                        <div>
                            <small>Current FPS</small>
                            <h2 id="fps">120</h2>
                        </div>
                        <span class="trend">+4.2%</span>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon purple">MS</div>
                        <div>
                            <small>Ping</small>
                            <h2 id="ping">32 ms</h2>
                        </div>
                        <span class="trend">STABLE</span>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon green">CPU</div>
                        <div>
                            <small>CPU Usage</small>
                            <h2 id="cpu">41%</h2>
                        </div>
                        <span class="trend">NORMAL</span>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon orange">RAM</div>
                        <div>
                            <small>Memory</small>
                            <h2 id="ram">3.8 GB</h2>
                        </div>
                        <span class="trend">NORMAL</span>
                    </div>

                </div>

                <div class="content-grid">

                    <div class="panel large">
                        <div class="panel-header">
                            <div>
                                <h3>Overlay Controls</h3>
                                <p>Demo visualization settings</p>
                            </div>

                            <span class="badge">DEMO</span>
                        </div>

                        <div class="controls">

                            <div class="control">
                                <div>
                                    <strong>Player Boxes</strong>
                                    <small>Show simulated player boxes</small>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" checked>
                                    <span></span>
                                </label>
                            </div>

                            <div class="control">
                                <div>
                                    <strong>Player Names</strong>
                                    <small>Display simulated names</small>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" checked>
                                    <span></span>
                                </label>
                            </div>

                            <div class="control">
                                <div>
                                    <strong>Distance</strong>
                                    <small>Display demo distance values</small>
                                </div>
                                <label class="switch">
                                    <input type="checkbox">
                                    <span></span>
                                </label>
                            </div>

                            <div class="control">
                                <div>
                                    <strong>Performance HUD</strong>
                                    <small>Show FPS and latency</small>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" checked>
                                    <span></span>
                                </label>
                            </div>

                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel-header">
                            <div>
                                <h3>System Status</h3>
                                <p>Demo environment</p>
                            </div>
                        </div>

                        <div class="system-status">
                            <div>
                                <span>Engine</span>
                                <strong class="ok">Running</strong>
                            </div>

                            <div>
                                <span>Overlay</span>
                                <strong class="ok">Active</strong>
                            </div>

                            <div>
                                <span>Data Source</span>
                                <strong>Simulation</strong>
                            </div>

                            <div>
                                <span>Protection</span>
                                <strong class="ok">Enabled</strong>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="panel players-panel">

                    <div class="panel-header">
                        <div>
                            <h3>Simulated Players</h3>
                            <p>Demo data only</p>
                        </div>

                        <button id="refreshBtn" class="refresh">
                            ↻ Refresh
                        </button>
                    </div>

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>PLAYER</th>
                                    <th>STATUS</th>
                                    <th>DISTANCE</th>
                                    <th>LATENCY</th>
                                    <th>ACTION</th>
                                </tr>
                            </thead>

                            <tbody id="playerTable"></tbody>
                        </table>
                    </div>

                </div>

            </section>

            <!-- PLAYERS -->
            <section id="players" class="page">

                <div class="panel">
                    <div class="panel-header">
                        <div>
                            <h3>Player Monitor</h3>
                            <p>Simulated environment</p>
                        </div>
                    </div>

                    <div class="player-cards" id="playerCards"></div>
                </div>

            </section>

            <!-- SETTINGS -->
            <section id="settings" class="page">

                <div class="panel settings-panel">

                    <div class="panel-header">
                        <div>
                            <h3>Dashboard Settings</h3>
                            <p>Customize the demo interface</p>
                        </div>
                    </div>

                    <div class="setting-row">
                        <div>
                            <strong>Auto Refresh</strong>
                            <small>Automatically update simulated statistics</small>
                        </div>

                        <label class="switch">
                            <input id="autoRefresh" type="checkbox" checked>
                            <span></span>
                        </label>
                    </div>

                    <div class="setting-row">
                        <div>
                            <strong>Notifications</strong>
                            <small>Show dashboard notifications</small>
                        </div>

                        <label class="switch">
                            <input type="checkbox" checked>
                            <span></span>
                        </label>
                    </div>

                    <div class="setting-row">
                        <div>
                            <strong>Compact Mode</strong>
                            <small>Reduce dashboard spacing</small>
                        </div>

                        <label class="switch">
                            <input id="compactMode" type="checkbox">
                            <span></span>
                        </label>
                    </div>

                </div>

            </section>

        </main>
    </div>

    <div id="toast" class="toast">
        Settings updated
    </div>

    <script src="script.js"></script>
</body>
</html>
